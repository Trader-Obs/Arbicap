# =============================================
# [YOUR EXCHANGE NAME] — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# =============================================

# ── APP ──────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Arbitragecap
FRONTEND_URL=http://127.0.0.1:5500
LOG_LEVEL=info

# ── DATABASE ─────────────────────────────────
# Get from: https://supabase.com (free tier) or AWS RDS
DATABASE_URL=postgresql://postgres.nzanzlmcycudhqwjdpep:Faseless32.@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# ── REDIS ────────────────────────────────────
# Get from: https://upstash.com (free tier) or Redis Cloud
REDIS_URL=redis://localhost:6379

# ── AUTH ─────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=07305076f8627e7641c0123a30e7db9432675c3244e6f14f319d73ad0249a2f5458e0cf213a846e1a3bd351b27e342145c5165305290dac4ca02f3a9b3c11736
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=22e9dc514fc2414cb1ef85890cd41d161339437f2e2ca3cb9f15b5b5d71d4f3b3d929ac3ceed2fb3a614cfaee35c7906d961962d4c8f8df39ae1242076eca1c0

# ── EMAIL ────────────────────────────────────
# Get from: https://sendgrid.com (free: 100 emails/day)
RESEND_API_KEY=re_UCJtdq4y_KJf6k68K1eZQUToLUc5HyYAv
FROM_EMAIL=onboarding@resend.dev

# ── KYC — SUMSUB ─────────────────────────────
# Get from: https://sumsub.com (sign up for developer access)
SUMSUB_APP_TOKEN=replace_with_sumsub_app_token
SUMSUB_SECRET_KEY=replace_with_sumsub_secret_key
SUMSUB_WEBHOOK_SECRET=replace_with_sumsub_webhook_secret

# ── FIAT PAYMENTS ─────────────────────────────
# Flutterwave: https://dashboard.flutterwave.com
FLUTTERWAVE_SECRET_KEY=FLWSECK-replace_with_your_key
FLUTTERWAVE_WEBHOOK_HASH=replace_with_webhook_hash
# Stripe: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_replace_with_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# ── CUSTODY — FIREBLOCKS ──────────────────────
# Get from: https://www.fireblocks.com
# For dev/testing, leave blank to use mock addresses
FIREBLOCKS_API_KEY=replace_with_fireblocks_api_key
FIREBLOCKS_API_SECRET_PATH=./fireblocks_secret.key
FIREBLOCKS_VAULT_ACCOUNT_ID=0
FIREBLOCKS_WEBHOOK_PUBLIC_KEY=

# ── BLOCKCHAIN NODES ─────────────────────────
# Alchemy (ETH/USDT/MATIC): https://alchemy.com (free tier available)
ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/replace_with_your_key
ALCHEMY_API_KEY=replace_with_your_alchemy_key
ALCHEMY_WEBHOOK_SIGNING_KEY=replace_with_alchemy_webhook_key
# QuickNode (BTC): https://quicknode.com
QUICKNODE_BTC_URL=https://replace.btc.quiknode.pro/replace/

# ── SMS ───────────────────────────────────────
# Twilio: https://twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_PHONE=+1xxxxxxxxxx
# OR Africa's Talking (better for Nigeria/Africa): https://africastalking.com
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=replace_with_africastalking_key

# ── FX RATES (fiat→USD conversion) ───────────
# These are static fallbacks; use a live FX API in production
# e.g. https://freecurrencyapi.com or https://openexchangerates.org
FX_NGN_USD=0.00065
FX_GBP_USD=1.27
FX_EUR_USD=1.09
FX_GHS_USD=0.066
FX_KES_USD=0.0077

# ── AWS S3 (for KYC document storage) ────────
# Get from: https://console.aws.amazon.com
AWS_ACCESS_KEY_ID=replace_with_aws_access_key
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=exchange-kyc-documents-replace

# ── COMPANY WALLET ADDRESSES ─────────────────
# All user deposits go to these addresses.
# Replace each value with your actual wallet address.
# You MUST set these before accepting any deposits.
WALLET_BTC=[YOUR_BTC_WALLET_ADDRESS]
WALLET_ETH=[YOUR_ETH_ERC20_WALLET_ADDRESS]
WALLET_TRX=[YOUR_TRX_TRON_WALLET_ADDRESS]
WALLET_BNB=[YOUR_BNB_BSC_WALLET_ADDRESS]
WALLET_SOL=[YOUR_SOL_WALLET_ADDRESS]
WALLET_XRP=[YOUR_XRP_WALLET_ADDRESS]
WALLET_XRP_MEMO=[YOUR_XRP_DESTINATION_TAG]
WALLET_LTC=[YOUR_LTC_WALLET_ADDRESS]
WALLET_DOGE=[YOUR_DOGE_WALLET_ADDRESS]
WALLET_ADA=[YOUR_ADA_WALLET_ADDRESS]
WALLET_AVAX=[YOUR_AVAX_WALLET_ADDRESS]

# ── WITHDRAWALS ───────────────────────────────
# Set to true ONLY when ready to process withdrawals on launch date.
WITHDRAWALS_LIVE=false

# ── P2P ───────────────────────────────────────
# P2P marketplace is browsable but trades are disabled until this is true.
# Set to true when you have enough users and liquidity.
P2P_LIVE=false

# ── ADMIN ────────────────────────────────────
# Email of the first admin user (set manually in DB after first registration)
ADMIN_EMAIL=admin@[yourdomain].com
